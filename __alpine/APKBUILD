# Maintainer: J.F.Gratton <jean-francois@famillegratton.net>
# Packager: Package builder <builder@famillegratton.net>
pkgname=nxtools
pkgver=1.3.3
pkgrel=3
pkgdir=/data/packages
pkgdesc="Nexus Repository Management tools"
url="https://git.famillegratton.net:3000/devops/nxtools"
arch=x86_64
license=GPL2
#depends="gcompat"
#install="$pkgname.post-install $pkgname.post-deinstall"
#source="$pkgname-$pkgver-$pkgrel.tar.bz2::http://localhost/$pkgname-$pkgver-$pkgrel.tar.bz2"
builddir="$startdir/src/BUILD"

binaryname=nxtools

prepare() {
	mkdir -p "$builddir"
	cp -R "$startdir"/../src/* "$builddir"/
}

build() {
	cd "$builddir"

	go env | egrep 'GOFLAGS|CGO_ENABLED|GOOS|GOARCH' || true

	# abuild runs build() with set -e, so both of these fast-fail the package
	# build; go test exits 0 for packages with no test files and only fails
	# on an actual test failure.
	go vet ./...
	go test ./...

	builddate="$(date +%Y.%m.%d)"

	# Static, non-PIE, internal linker
	go build -trimpath -ldflags="-s -w -buildid= -linkmode=internal -X nxtools/cmd.buildVersion=$pkgver -X nxtools/cmd.buildDate=$builddate" -o "$binaryname" .
}

package() {
	install -d "$pkgdir"/opt/bin
	install -m755 "$builddir/$binaryname" "$pkgdir/opt/bin/$binaryname"
}
